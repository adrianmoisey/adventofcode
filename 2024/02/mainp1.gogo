package main

import (
	_ "embed"
	"fmt"
	"slices"
	"strconv"
	"strings"
)

//go:embed sample.txt
var input string

var (
	total []int
)

func main() {
	report := [][]int{}
	lines := strings.Split(strings.TrimSpace(input), "\n")
	for _, line := range lines {
		line_s := strings.Split(line, " ")
		line_i := []int{}
		for _, num := range line_s {
			num_int, _ := strconv.Atoi(string(num))
			line_i = append(line_i, num_int)
		}
		report = append(report, line_i)
	}

	safeReports := 0

	for _, line := range report {
		badLevel := 0

		if line[0] > line[1] {
			slices.Reverse(line)
		}
		for i, num := range line {

			if i+1 == len(line) {
				safeReports++
				break
			}

			next := line[i+1]
			if num < next && next <= num+3 {
				continue
			} else {
				fmt.Println("here")
				badLevel++
				if badLevel > 1 {
					fmt.Println("here")

					break
				}
			}
		}
	}
	fmt.Println("Part 1", safeReports)
}

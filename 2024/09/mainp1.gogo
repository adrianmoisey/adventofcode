package main

import (
	_ "embed"
	"fmt"
	"slices"
	"strconv"
	"strings"
)

//go:embed input.txt
var input string

func main() {
	lines := strings.Split(strings.TrimSpace(input), "\n")
	Part1(lines[0])
}

func Part1(input string) {
	var BlockID int

	DiskLayout := make([]int, 0)

	for i, c := range input {
		if i%2 == 0 {
			value, _ := strconv.Atoi(string(c))
			for i := 0; i < value; i++ {
				DiskLayout = append(DiskLayout, []int{BlockID}...)
			}
			BlockID++

		} else {
			value, _ := strconv.Atoi(string(c))
			for i := 0; i < value; i++ {
				DiskLayout = append(DiskLayout, []int{-1}...)
			}
		}
	}
	for slices.Contains(DiskLayout, -1) {
		lastElement := pop(&DiskLayout)
		if lastElement == -1 {
			continue
		} else {
			index := slices.Index(DiskLayout, -1)
			DiskLayout[index] = lastElement
		}
	}
	fmt.Println("Here", DiskLayout)
	var total int
	for i, v := range DiskLayout {
		total += i * v
	}
	fmt.Println(total)
}

func pop(xs *[]int) int {
	x := (*xs)[len(*xs)-1]   // Store the last value to return.
	*xs = (*xs)[:len(*xs)-1] // Remove the last value from the slice.
	return x
}

package main

import (
	_ "embed"
	"fmt"
	"slices"
	"strings"
)

//go:embed input.txt
var input string

func main() {
	lines := strings.Split(strings.TrimSpace(input), "\n")
	Part1(lines)
}

func Part1(input []string) {
	var Grid [][]string
	Grid = make([][]string, len(input))

	for i := range Grid {
		Grid[i] = make([]string, len(input[0]))
	}

	for x, line := range input {
		for y, character := range line {
			Grid[x][y] = string(character)
		}
	}

	var Seen map[Coords]bool
	Seen = make(map[Coords]bool)
	total := 0

	for x, line := range Grid {
		for y := range line {
			coords := Coords{x, y}
			if ok := Seen[coords]; !ok {
				total += DFS(coords, Grid, Seen)
			}
		}
	}
	fmt.Println(total)
}

type Coords struct {
	X int
	Y int
}

func DFS(coord Coords, grid [][]string, Seen map[Coords]bool) int {
	var PeremiterTotal int
	var AreaTotal int
	S := []Coords{}
	S = append(S, coord)
	var SeenLocal map[Coords]bool
	SeenLocal = make(map[Coords]bool)
	for {
		if len(S) == 0 {
			break
		}
		V := S[len(S)-1]
		S = S[:len(S)-1]

		if Seen[V] == true {
			continue
		}
		Seen[V] = true
		SeenLocal[V] = true
		AreaTotal++

		character := grid[V.X][V.Y]

		if V.X > 0 {
			if string(grid[V.X-1][V.Y]) != character {
				PeremiterTotal++
			} else if string(grid[V.X-1][V.Y]) == character {
				if !slices.Contains(S, Coords{V.X - 1, V.Y}) {
					S = append(S, Coords{V.X - 1, V.Y})
				}
			}
		} else {
			PeremiterTotal++
		}
		if V.X < len(grid)-1 {
			if string(grid[V.X+1][V.Y]) != character {
				PeremiterTotal++
			} else if string(grid[V.X+1][V.Y]) == character {
				if !slices.Contains(S, Coords{V.X + 1, V.Y}) {
					S = append(S, Coords{V.X + 1, V.Y})
				}
			}
		} else {
			PeremiterTotal++
		}

		if V.Y > 0 {
			if string(grid[V.X][V.Y-1]) != character {
				PeremiterTotal++
			} else if string(grid[V.X][V.Y-1]) == character {
				if !slices.Contains(S, Coords{V.X, V.Y - 1}) {
					S = append(S, Coords{V.X, V.Y - 1})
				}
			}
		} else {
			PeremiterTotal++
		}
		if V.Y < len(grid)-1 {
			if string(grid[V.X][V.Y+1]) != character {
				PeremiterTotal++
			} else if string(grid[V.X][V.Y+1]) == character {
				if !slices.Contains(S, Coords{V.X, V.Y + 1}) {
					S = append(S, Coords{V.X, V.Y + 1})
				}
			}
		} else {
			PeremiterTotal++
		}
	}

	direction := "r"
	corners := 0
	startCoord := coord
	pointerCoord := Coords{startCoord.X, startCoord.Y + 1}
	for {
		fmt.Println("Pointer", pointerCoord)
		currentLetter := grid[pointerCoord.X][pointerCoord.Y]

		if direction == "r" {
			fmt.Println("right")
			if pointerCoord.Y+1 > len(grid[0])-1 || grid[pointerCoord.X][pointerCoord.Y+1] != currentLetter {
				direction = "d"
				corners++
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y}
			} else {
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y + 1}
			}
		} else if direction == "d" {
			fmt.Println("down")
			if pointerCoord.X+1 > len(grid)-1 || grid[pointerCoord.X+1][pointerCoord.Y] != currentLetter {
				direction = "l"
				corners++
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y}
			} else {
				pointerCoord = Coords{pointerCoord.X + 1, pointerCoord.Y}
			}
		} else if direction == "l" {
			fmt.Println("left")
			if pointerCoord.Y-1 < 0 || grid[pointerCoord.X][pointerCoord.Y-1] != currentLetter {
				direction = "u"
				corners++
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y}
			} else {
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y - 1}
			}
		} else if direction == "u" {
			fmt.Println("up")
			if pointerCoord.X-1 < 0 || grid[pointerCoord.X-1][pointerCoord.Y] != currentLetter {
				direction = "r"
				corners++
				pointerCoord = Coords{pointerCoord.X, pointerCoord.Y}
			} else {
				pointerCoord = Coords{pointerCoord.X - 1, pointerCoord.Y}
			}
		}

	}
	return AreaTotal * PeremiterTotal
}

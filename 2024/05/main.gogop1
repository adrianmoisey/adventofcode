package main

import (
	_ "embed"
	"fmt"
	"slices"
	"strconv"
	"strings"
)

//go:embed input.txt
var input string

func main() {
	lines := strings.Split(strings.TrimSpace(input), "\n")

	Part1(lines)
}

type Rule struct {
	Before int
	After  int
}

func Part1(input []string) {

	var rules []Rule
	var updates [][]int
	var total int

	for _, line := range input {
		if strings.Contains(line, "|") {
			lineSplit := strings.Split(line, "|")
			firstRule, _ := strconv.Atoi(lineSplit[0])
			secondRule, _ := strconv.Atoi(lineSplit[1])
			rule := Rule{Before: firstRule, After: secondRule}
			rules = append(rules, rule)
		}

		if strings.Contains(line, ",") {
			lineSplit := strings.Split(line, ",")
			update := make([]int, len(lineSplit))
			for i, value := range lineSplit {
				valueInt, _ := strconv.Atoi(value)
				update[i] = valueInt
			}
			updates = append(updates, update)
		}
	}

	// fmt.Println("Rules", rules)
	// fmt.Println("Updates", updates)

	for _, update := range updates {
		// fmt.Println(update)
		var valid bool
		valid = true

		for _, rule := range rules {
			left := slices.Index(update, rule.Before)
			right := slices.Index(update, rule.After)
			if left == -1 || right == -1 {
				continue
			}
			if left > right {
				// fmt.Println(left, right)
				// fmt.Println("Fail")
				valid = false
			}
		}
		if valid {
			middle := len(update) - 1
			middle = middle / 2
			total += update[middle]
		}
	}
	fmt.Println(total)
}

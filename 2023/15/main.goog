package main

import (
	_ "embed"
	"fmt"
	"strings"
)

//go:embed input.txt
var input string
var total int

func Hash(input string) (value int) {
	currentValue := 0
	for _, c := range input {
		currentValue += int(c)
		currentValue = currentValue * 17
		currentValue = currentValue % 256
	}
	return currentValue
}

func main() {
	linesInput := strings.Split(strings.TrimSpace(input), "\n")
	steps := strings.Split(linesInput[0], ",")
	for _, step := range steps {
		fmt.Println(step)

		Value := Hash(step)
		total += Value
	}

	fmt.Println(total)
}

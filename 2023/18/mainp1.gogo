package main

import (
	_ "embed"
	"fmt"
	"strconv"
	"strings"
)

//go:embed input.txt
var input string
var Grid map[int]map[int]string

var Start [2]int = [2]int{0, 0}
var Current [2]int = Start

// BFS
var BFSQueue [][2]int

func main() {
	linesInput := strings.Split(strings.TrimSpace(input), "\n")
	Grid := make(map[int]map[int]string)

	for _, line := range linesInput {
		SplitLine := strings.Split(line, " ")
		Direction := SplitLine[0]
		DistanceS := SplitLine[1]
		Distance, _ := strconv.Atoi(DistanceS)

		if Direction == "U" {
			for i := 0; i < Distance; i++ {
				X := Current[0]
				Y := Current[1]
				X--
				_, exists := Grid[X]
				if !exists {
					Grid[X] = make(map[int]string)
				}
				Grid[X][Y] = "#"
				Current[0] = X
			}
		} else if Direction == "D" {
			for i := 0; i < Distance; i++ {
				X := Current[0]
				Y := Current[1]
				X++
				_, exists := Grid[X]
				if !exists {
					Grid[X] = make(map[int]string)
				}
				Grid[X][Y] = "#"
				Current[0] = X
			}

		} else if Direction == "L" {
			for i := 0; i < Distance; i++ {
				X := Current[0]
				Y := Current[1]
				Y--
				_, exists := Grid[X]
				if !exists {
					Grid[X] = make(map[int]string)
				}
				Grid[X][Y] = "#"
				Current[1] = Y
			}

		} else if Direction == "R" {
			for i := 0; i < Distance; i++ {
				X := Current[0]
				Y := Current[1]
				Y++
				_, exists := Grid[X]
				if !exists {
					Grid[X] = make(map[int]string)
				}
				Grid[X][Y] = "#"
				Current[1] = Y
			}
		}
	}

	// BFS
	//fmt.Println(Start)

	BFSStart := [2]int{Start[0] + 1, Start[1] + 1}
	BFSQueue = append(BFSQueue, BFSStart)

	for {
		if len(BFSQueue) == 0 {
			break
		}

		Location := BFSQueue[len(BFSQueue)-1]
		BFSQueue = BFSQueue[:len(BFSQueue)-1]

		Up := Location
		Up[0] = Location[0] - 1

		Down := Location
		Down[0] = Location[0] + 1

		Left := Location
		Left[1] = Location[1] - 1

		Right := Location
		Right[1] = Location[1] + 1

		_, up := Grid[Up[0]][Up[1]]
		if !up {
			Grid[Up[0]][Up[1]] = "#"
			BFSQueue = append(BFSQueue, [2]int{Up[0], Up[1]})

		}
		_, down := Grid[Down[0]][Down[1]]
		if !down {
			Grid[Down[0]][Down[1]] = "#"
			BFSQueue = append(BFSQueue, [2]int{Down[0], Down[1]})

		}

		_, left := Grid[Left[0]][Left[1]]
		if !left {
			Grid[Left[0]][Left[1]] = "#"
			BFSQueue = append(BFSQueue, [2]int{Left[0], Left[1]})

		}
		_, right := Grid[Right[0]][Right[1]]
		fmt.Println(right)
		fmt.Println(Right)
		if !right {
			Grid[Right[0]][Right[1]] = "#"
			BFSQueue = append(BFSQueue, [2]int{Right[0], Right[1]})

		}
	}
	fmt.Println(Grid)
	total := 0
	for k, _ := range Grid {
		total += len(Grid[k])
	}
	fmt.Println(total)
}
